# Copy to server/.env and fill in. .env is git-ignored.

# Required in production; in dev a random one is generated and remembered in the database.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Mapbox PUBLIC token (starts with pk.). Powers maps, address search, route
# optimization and clearance-aware directions. Free account: mapbox.com
MAPBOX_TOKEN=

# Demo accounts are created on first boot in dev. Set to false to turn off.
SEED_DEMO=true

# ---- storage ---------------------------------------------------------------
# SQLite file. On a host, point this at a persistent volume (e.g. /data/wheelie.db).
DB_PATH=data/wheelie.db
# How many days of ride history / boarding logs to keep.
RETENTION_DAYS=365

# ---- hosting ---------------------------------------------------------------
PORT=4000
# Behind a load balancer (Fly, Render, Railway): set both.
TRUST_PROXY=
REQUIRE_HTTPS=
# Used for "today" (absences) and on-time reports.
SCHOOL_TIMEZONE=America/New_York

# ---- email (password reset, verification, roster invites) --------------------
# https://resend.com - without a key, emails are printed in the server console in dev.
RESEND_API_KEY=
EMAIL_FROM="Wheelie <no-reply@yourdomain.com>"

# ---- push notifications -------------------------------------------------------
# Optional Expo access token (raises push limits): expo.dev -> Access tokens
EXPO_ACCESS_TOKEN=

# ---- legal --------------------------------------------------------------------
# Shown on the sign-up screen. Bump TERMS_VERSION when the terms change.
TERMS_VERSION=2026-10
PRIVACY_URL=
TERMS_URL=

# ---- ride monitoring (defaults shown) -----------------------------------------
# Seconds before arrival to send "bus arriving soon"
APPROACH_SECONDS=300
# How far from the planned road before the office is alerted
OFF_ROUTE_METERS=200
# Seconds sitting still away from a stop before the office is alerted
STATIONARY_SECONDS=300
