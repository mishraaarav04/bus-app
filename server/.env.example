# Copy to server/.env and fill in. .env is git-ignored.

# Required in production; in dev a random one is used per run.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Mapbox PUBLIC token (starts with pk.). Powers maps, address search, route
# optimization and clearance-aware directions. Free account: mapbox.com
MAPBOX_TOKEN=

# Demo accounts are created on boot in dev. Set to false to turn off.
SEED_DEMO=true
